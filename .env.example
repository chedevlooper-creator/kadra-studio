# Local secrets. Copy to .env.local; never commit it and never prefix a key with NEXT_PUBLIC_.
KADRA_DATA_DIR=.data

# Optional bridge (api-docs.deepseek.com): web search (/v1/tools/search), character research,
# script planning and multimodal Vision judging. Without it, planning falls back to NVIDIA or local rules.
DEEPSEEK_API_KEY=
# Optional planner/reviewer (build.nvidia.com). It no longer generates images.
NVIDIA_API_KEY=
# Required for production: character sheets, scene frames and image-to-video (paid, after a quote).
GMI_API_KEY=
# Optional video provider: Higgsfield Seedance 2.5 image-to-video (API key from open.higgsfield.ai).
HIGGSFIELD_API_KEY=

# Optional overrides.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# KADRA_TITLE_FONT=/System/Library/Fonts/Supplemental/Arial.ttf
# Set to "off" to run the production worker separately with `npm run worker`.
# KADRA_WORKER=off

# Safety rails for paid providers (GMI).
# Total paid spend allowed across every project, in USD. Unset means no extra ceiling.
# KADRA_MAX_SPEND_USD=5
# Emergency stop: set to "on" to refuse every paid request without a restart.
# KADRA_KILL_SWITCH=off
