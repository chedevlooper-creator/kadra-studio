# Local secrets. Copy to .env.local; never commit it and never prefix a key with NEXT_PUBLIC_.
KADRA_DATA_DIR=.data

# Cross-model bridge (api-docs.deepseek.com): web search (/v1/tools/search), character research,
# script planning, multimodal Vision judging, and prompt/reference preparation.
DEEPSEEK_API_KEY=
# Free tier (build.nvidia.com): fallback scene planning, FLUX.2 Klein frames, fallback frame review.
NVIDIA_API_KEY=
# Optional paid reference images (Nano Banana 2.1) & image-to-video (only after you approve a quote).
GMI_API_KEY=

# Optional overrides.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# KADRA_TITLE_FONT=/System/Library/Fonts/Supplemental/Arial.ttf
# Set to "off" to run the production worker separately with `npm run worker`.
# KADRA_WORKER=off

# Safety rails for paid providers (GMI).
# Total paid spend allowed across every project, in USD. Unset means no extra ceiling.
# KADRA_MAX_SPEND_USD=5
# Emergency stop: set to "on" to refuse every paid request without a restart.
# KADRA_KILL_SWITCH=off
